local function CreateButton(parentList, name, callback)
local Btn = Instance.new("TextButton")
Btn.Parent = parentList Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28) Btn.Size = UDim2.new(1, -10, 0, 38) Btn.Font = Enum.Font.GothamBold Btn.Text = name Btn.TextColor3 = Color3.fromRGB(240, 240, 240) Btn.TextSize = 12
StyleElement(Btn, 6, Color3.fromRGB(38, 38, 38))
Btn.MouseButton1Click:Connect(callback) return Btn
end

local function CreateToggle(parentList, name, callback)
local ToggleBtn = Instance.new("TextButton") local enabled = false
ToggleBtn.Parent = parentList ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 25, 25) ToggleBtn.Size = UDim2.new(1, -10, 0, 38) ToggleBtn.Font = Enum.Font.GothamBold ToggleBtn.Text = name .. " : OFF" ToggleBtn.TextColor3 = Color3.fromRGB(240, 240, 240) ToggleBtn.TextSize = 12
StyleElement(ToggleBtn, 6)
ToggleBtn.MouseButton1Click:Connect(function() enabled = not enabled ToggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(25, 45, 25) or Color3.fromRGB(45, 25, 25) ToggleBtn.Text = name .. (enabled and " : ON" or " : OFF") callback(enabled) end)
return ToggleBtn
end
local function CreateCustomValueSlider(parentList, labelName, defaultVal, callback)
local Container = Instance.new("Frame")
Container.Parent = parentList Container.BackgroundColor3 = Color3.fromRGB(22, 22, 22) Container.Size = UDim2.new(1, -10, 0, 42) StyleElement(Container, 6, Color3.fromRGB(35, 35, 35))
local Label = Instance.new("TextLabel", Container)
Label.BackgroundTransparency = 1 Label.Position = UDim2.new(0.04, 0, 0, 0) Label.Size = UDim2.new(0.5, 0, 1, 0) Label.Font = Enum.Font.GothamBold Label.Text = labelName Label.TextColor3 = Color3.fromRGB(200, 200, 200) Label.TextSize = 12 Label.TextXAlignment = Enum.TextXAlignment.Left
local ValueInput = Instance.new("TextBox", Container)
ValueInput.BackgroundColor3 = Color3.fromRGB(32, 32, 32) ValueInput.Position = UDim2.new(0.65, 0, 0.15, 0) ValueInput.Size = UDim2.new(0, 120, 0, 28) ValueInput.Font = Enum.Font.GothamBold ValueInput.Text = tostring(defaultVal) ValueInput.TextColor3 = Color3.fromRGB(0, 170, 255) ValueInput.TextSize = 12 StyleElement(ValueInput, 4, Color3.fromRGB(50, 50, 50))
ValueInput.FocusLost:Connect(function()
local num = tonumber(ValueInput.Text)
if num then callback(num) else ValueInput.Text = tostring(defaultVal) end
end)
return ValueInput
end
local function RunAnimationLoop(offsetCFrame)
if BangLoop then BangLoop:Disconnect() end
local p1 = game.Players.LocalPlayer.Character
local p2 = game.Workspace:FindFirstChild(TargetPlayerName)
if p1 and p2 and p1:FindFirstChild("HumanoidRootPart") and p2:FindFirstChild("HumanoidRootPart") then
local myHRP = p1.HumanoidRootPart
local targetHRP = p2.HumanoidRootPart
local moveIn = true
BangLoop = game:GetService("RunService").Heartbeat:Connect(function()
if p1 and p2 and p1:FindFirstChild("HumanoidRootPart") and p2:FindFirstChild("HumanoidRootPart") then
myHRP.CFrame = targetHRP.CFrame * offsetCFrame * CFrame.new(0, 0, moveIn and 0.4 or -0.4) moveIn = not moveIn
else if BangLoop then BangLoop:Disconnect() end end
end)
end
end

