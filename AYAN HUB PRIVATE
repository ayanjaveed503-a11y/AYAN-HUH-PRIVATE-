-- Tab Navigation Swapper System
local function SwitchTab(activeList, activeBtn, inactiveBtn1, inactiveBtn2)
    ScriptsList.Visible = (ScriptsList == activeList)
    TogglesList.Visible = (TogglesList == activeList)
    PlayerList.Visible = (PlayerList == activeList)
    SearchPlayerBox.Visible = (PlayerList == activeList)
    
    activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    inactiveBtn1.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    inactiveBtn1.TextColor3 = Color3.fromRGB(180, 180, 180)
    inactiveBtn2.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    inactiveBtn2.TextColor3 = Color3.fromRGB(180, 180, 180)
end

