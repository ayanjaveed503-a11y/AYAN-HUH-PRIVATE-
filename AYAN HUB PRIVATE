-- Live Autocomplete Filter for Player Search Bar
SearchPlayerBox:GetPropertyChangedSignal("Text"):Connect(function()
    local text = string.lower(SearchPlayerBox.Text)
    TargetPlayerName = ""
    for _, player in pairs(game.Players:GetPlayers()) do
        if string.find(string.lower(player.Name), text) or string.find(string.lower(player.DisplayName), text) then
            TargetPlayerName = player.Name
            SearchPlayerBox.TextColor3 = Color3.fromRGB(0, 255, 100)
            break
        end
    end
    if SearchPlayerBox.Text == "" then
        SearchPlayerBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

-- Core Generators for Buttons and Toggles
local function CreateButton(parentList, name, callback)
    local Btn = Instance.new("TextButton")
    Btn.Parent = parentList
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    Btn.Size = UDim2.new(1, -10, 0, 40)
    Btn.Font = Enum.Font.SourceSansBold
    Btn.Text = name
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 16.000
    Btn.MouseButton1Click:Connect(callback)
    return Btn
end

local function CreateToggle(parentList, name, callback)
    local ToggleBtn = Instance.new("TextButton")
    local enabled = false
    ToggleBtn.Parent = parentList
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
    ToggleBtn.Size = UDim2.new(1, -10, 0, 40)
    ToggleBtn.Font = Enum.Font.SourceSansBold
    ToggleBtn.Text = name .. " : OFF"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 16.000
    
    ToggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        ToggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(30, 100, 30) or Color3.fromRGB(60, 30, 30)
        ToggleBtn.Text = name .. (enabled and " : ON" or " : OFF")
        callback(enabled)
end)
return ToggleBtn
end
-- Fixed Built-in Custom Target Loop Engine
local function RunAnimationLoop(offsetCFrame)
if BangLoop then BangLoop:Disconnect() end
local p1 = game.Players.LocalPlayer.Character
local p2 = game.Workspace:FindFirstChild(TargetPlayerName)
if p1 and p2 and p1:FindFirstChild("HumanoidRootPart") and p2:FindFirstChild("HumanoidRootPart") then
local myHRP = p1.HumanoidRootPart
local targetHRP = p2.HumanoidRootPart
local moveIn = true
BangLoop = game:GetService("RunService").Heartbeat:Connect(function()
if p1 and p2 and p1:FindFirstChild("HumanoidRootPart") and p2:FindFirstChild("HumanoidRootPart") then
local targetPos = targetHRP.CFrame * offsetCFrame
if moveIn then
myHRP.CFrame = targetPos * CFrame.new(0, 0, 0.4)
else
myHRP.CFrame = targetPos * CFrame.new(0, 0, -0.4)
end
moveIn = not moveIn
else
if BangLoop then BangLoop:Disconnect() end
end
end)
end
end
