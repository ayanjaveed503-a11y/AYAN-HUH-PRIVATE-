local function RefreshPlayerDropdown()
    for _, child in pairs(PlayerDropdown:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer then
            local PBtn = Instance.new("TextButton")
            PBtn.Parent = PlayerDropdown
            PBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
            PBtn.Size = UDim2.new(1, -8, 0, 32)
            PBtn.Font = Enum.Font.GothamBold
            PBtn.Text = "   " .. player.DisplayName .. " (@" .. player.Name .. ")"
            PBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            PBtn.TextSize = 11
            PBtn.TextXAlignment = Enum.TextXAlignment.Left
            StyleElement(PBtn, 4)
            PBtn.MouseButton1Click:Connect(function()
                TargetPlayerName = player.Name
                for _, b in pairs(PlayerDropdown:GetChildren()) do if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(220, 220, 220) b.BackgroundColor3 = Color3.fromRGB(24,24,24) end end
                PBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                PBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
            end)
        end
    end
end
