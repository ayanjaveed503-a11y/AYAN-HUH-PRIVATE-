local function SetupTabBtn(btn, text, pos, textColor, active)
    btn.Parent = TabBar
    btn.BackgroundColor3 = active and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(20, 20, 20)
    btn.Position = pos
    btn.Size = UDim2.new(0, 144, 1, 0)
