local function CreateScrollList(name, visible, pos, size, canvas)
    local List = Instance.new("ScrollingFrame")
    List.Name = name
    List.Parent = MainHub
    List.Active = true
    List.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    List.Position = pos
    List.Size = size
    List.ScrollBarThickness = 4
    List.ScrollBarImageColor3 = Color3.fromRGB(0, 170, 255)
    List.Visible = visible
    List.CanvasSize = canvas
    List.BorderSizePixel = 0
    StyleElement(List, 8)
    return List
end

